<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="KillerPDF.MainWindow"
        Title="KillerPDF"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- Toolbar button: dark, hover-highlighted, no border -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgHover}"/>
        </Style>
        <Style Selector="Button.toolbar.accent">
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.toolbar.danger">
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
        </Style>
        <!-- Chrome buttons (min/max/close) -->
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgHover}"/>
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
        </Style>
        <!-- Toolbar separator -->
        <Style Selector="Border.tbsep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource BorderDim}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="36,Auto,*,28">

        <!-- ── Title bar ────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderDim}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Spacing="0">
                    <TextBlock Text="Killer"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="PDF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGreen}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileNameLabel"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Spacing="0">
                    <Button Classes="chrome" Click="Minimize_Click" Content="—" ToolTip.Tip="Minimize"/>
                    <Button Classes="chrome" Click="Maximize_Click" Content="☐" ToolTip.Tip="Maximize"/>
                    <Button Classes="chrome close" Click="Close_Click" Content="✕" ToolTip.Tip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Search bar (floats over toolbar when visible) ────────── -->
        <Border Grid.Row="1"
                x:Name="SearchBar"
                IsVisible="False"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource AccentGreen}"
                BorderThickness="0,0,0,2"
                Padding="12,6"
                ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🔍"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>
                <TextBox x:Name="SearchBox"
                         Width="240"
                         Watermark="Find in document…"
                         KeyDown="SearchBox_KeyDown"/>
                <Button Classes="toolbar" Click="SearchPrev_Click" Content="↑" ToolTip.Tip="Previous match"/>
                <Button Classes="toolbar" Click="SearchNext_Click" Content="↓" ToolTip.Tip="Next match"/>
                <TextBlock x:Name="SearchStatus"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"/>
                <Button Classes="toolbar" Click="SearchClose_Click" Content="✕" ToolTip.Tip="Close (Esc)"/>
            </StackPanel>
        </Border>

        <!-- ── Toolbar ──────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderDim}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <!-- File ops -->
                <Button Classes="toolbar" Click="OpenBtn_Click" Content="📂" ToolTip.Tip="Open (Ctrl+O)"/>
                <Button Classes="toolbar accent" Click="SaveBtn_Click" Content="💾" ToolTip.Tip="Save in place (Ctrl+S)" x:Name="SaveBtn"/>
                <Button Classes="toolbar" Click="SaveAsBtn_Click" Content="⤓" ToolTip.Tip="Save As… (Ctrl+Shift+S)" x:Name="SaveAsBtn"/>
                <Button Classes="toolbar" Click="MergeBtn_Click" Content="🔗" ToolTip.Tip="Merge other PDFs into this one"/>

                <Border Classes="tbsep"/>

                <!-- Page ops -->
                <Button Classes="toolbar" Click="InsertBlank_Click" Content="📄" ToolTip.Tip="Insert blank page after current"/>
                <Button Classes="toolbar" Click="RotateLeft_Click" Content="⟲" ToolTip.Tip="Rotate page 90° counter-clockwise"/>
                <Button Classes="toolbar" Click="RotateRight_Click" Content="⟳" ToolTip.Tip="Rotate page 90° clockwise"/>
                <Button Classes="toolbar" Click="MoveUp_Click" Content="↑" ToolTip.Tip="Move page up"/>
                <Button Classes="toolbar" Click="MoveDown_Click" Content="↓" ToolTip.Tip="Move page down"/>
                <Button Classes="toolbar danger" Click="DeletePage_Click" Content="✕" ToolTip.Tip="Delete current page"/>
                <Button Classes="toolbar" Click="ExtractPage_Click" Content="✂" ToolTip.Tip="Extract current page to a new file"/>

                <Border Classes="tbsep"/>

                <!-- Edit tools -->
                <ToggleButton Classes="toolbar" Content="↖" ToolTip.Tip="Select (click annotation, Delete to remove)" x:Name="ToolSelectBtn" Click="ToolSelect_Click" IsChecked="True"/>
                <ToggleButton Classes="toolbar" Content="T" ToolTip.Tip="Text (click to place text)" x:Name="ToolTextBtn" Click="ToolText_Click"/>
                <ToggleButton Classes="toolbar" Content="▓" ToolTip.Tip="Highlight" x:Name="ToolHighlightBtn" Click="ToolHighlight_Click"/>
                <ToggleButton Classes="toolbar" Content="✎" ToolTip.Tip="Draw (freehand pen)" x:Name="ToolDrawBtn" Click="ToolDraw_Click"/>
                <Button Classes="toolbar" Click="InsertImage_Click" Content="🖼" ToolTip.Tip="Insert image"/>
                <Button Classes="toolbar" Click="DrawSignature_Click" Content="✍" ToolTip.Tip="Draw a signature"/>
                <Button Classes="toolbar" Click="InsertSignature_Click" Content="✎🖼" ToolTip.Tip="Import signature from image file"/>
                <ToggleButton Classes="toolbar" Content="⌖" ToolTip.Tip="Crop (drag a rectangle, then Apply)" x:Name="ToolCropBtn" Click="ToolCrop_Click"/>

                <Border Classes="tbsep"/>

                <Button Classes="toolbar" Click="SearchOpen_Click" Content="🔍" ToolTip.Tip="Find in document (Ctrl+F)"/>
                <Button Classes="toolbar" Click="SaveFlattened_Click" Content="🔒" ToolTip.Tip="Save flattened (bake annotations into PDF)"/>
                <Button Classes="toolbar" Click="Undo_Click" Content="↶" ToolTip.Tip="Undo last annotation (Ctrl+Z)"/>

                <Border Classes="tbsep"/>

                <!-- Zoom (placeholders) -->
                <Button Classes="toolbar" Click="ZoomOut_Click" Content="−" ToolTip.Tip="Zoom out"/>
                <TextBlock x:Name="ZoomLabel"
                           Text="100%"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}"
                           MinWidth="48"
                           TextAlignment="Center"/>
                <Button Classes="toolbar" Click="ZoomIn_Click" Content="+" ToolTip.Tip="Zoom in"/>
                <Button Classes="toolbar" Click="FitWidth_Click" Content="↔" ToolTip.Tip="Fit Width"/>
            </StackPanel>
        </Border>

        <!-- ── Main content (sidebar + preview) ─────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*">

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderDim}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderDim}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <TextBlock Text="Pages"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <ListBox Grid.Row="1"
                             x:Name="PageList"
                             Padding="8"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="PageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="11"
                                           Padding="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="{StaticResource BgDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderDim}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentGreenDim}"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource BgHover}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Preview area -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource BgDark}">
                <Panel>
                    <!-- Empty-state hint -->
                    <TextBlock x:Name="EmptyHint"
                               Text="Open a PDF to begin"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="14"/>
                    <!-- Page + annotation overlay (Grid stacks them) -->
                    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PageImage"
                               Stretch="None"/>
                        <Canvas x:Name="AnnotationCanvas"
                                Background="Transparent"
                                PointerPressed="AnnotationCanvas_PointerPressed"
                                PointerMoved="AnnotationCanvas_PointerMoved"
                                PointerReleased="AnnotationCanvas_PointerReleased"/>
                    </Grid>
                </Panel>
            </ScrollViewer>
        </Grid>

        <!-- ── Crop confirmation bar (floats above status when crop is pending) ── -->
        <Border Grid.Row="3"
                x:Name="CropBar"
                IsVisible="False"
                Background="{StaticResource AccentGreenDim}"
                BorderBrush="{StaticResource AccentGreen}"
                BorderThickness="0,2,0,0"
                Padding="12,4"
                ZIndex="50">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Crop pending — review and apply"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="12"/>
                <Button Classes="toolbar accent" Click="CropApply_Click" Content="✓" ToolTip.Tip="Apply crop"/>
                <Button Classes="toolbar danger" Click="CropCancel_Click" Content="✕" ToolTip.Tip="Cancel"/>
            </StackPanel>
        </Border>

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderDim}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="PageCounter"
                           Text=""
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
